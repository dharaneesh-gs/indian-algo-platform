# API authentication: use a unique random value with 32+ characters.
APP_API_TOKEN=replace-with-random-secret-at-least-32-characters
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

PAPER_STARTING_CASH=100000
