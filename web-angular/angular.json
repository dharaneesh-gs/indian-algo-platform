{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "web-client": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web-client",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["src/styles.css"],
            "outputHashing": "all"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "budgets": [
                {"type":"initial","maximumWarning":"1.2mb","maximumError":"2mb"},
                {"type":"anyComponentStyle","maximumWarning":"12kb","maximumError":"20kb"}
              ]
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "analytics": "5ec188f2-0b5d-45d9-ba7f-aa130dcf62ff"
  }
}
